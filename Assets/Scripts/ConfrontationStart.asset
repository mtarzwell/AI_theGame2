    nextDialogue: {fileID: 11400000, guid: 390275de67b24044299f837bc0bd1c50, type: 2}
    flagToSet: 
    flagValue: 1
    statToChange: Inquisitive
    statDelta: 1
    requiredFlag: 
    requiredValue: 1
    triggerMeltdown: 0
    switchToObie: 0
  - text: '[Confront] Read the circles (Mysterious)'
